# Copy this file to .env and fill in your token:
#   cp .env.example .env
#
# This is optional — the sidebar in the app also lets a user paste their own
# Hugging Face token, which is sent with each question and takes priority
# over this one. Set this if you want the server to work without that.
HF_API_KEY=hf_your-token-here

# Optional overrides (defaults shown)
HF_MODEL=meta-llama/Llama-3.1-8B-Instruct
CHUNK_SIZE=800
CHUNK_OVERLAP=120
TOP_K=4
